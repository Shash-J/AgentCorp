{
  "name": "agentcorp-broker",
  "version": "0.1.0",
  "description": "Local-first MCP coordination broker for teams of AI agents",
  "type": "module",
  "license": "Apache-2.0",
  "author": "AgentCorp contributors",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agentcorp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "AgentCorp_Design_Spec.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/console', 'dist/console', { recursive: true, force: true })\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "multi-agent",
    "coordination",
    "human-in-the-loop",
    "sqlite"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^14.0.0",
    "smol-toml": "^1.4.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
